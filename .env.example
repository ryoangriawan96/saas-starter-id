# Copy to .env and fill in. NEVER commit .env.

# Database (SQLite for local dev; switch to PostgreSQL/MySQL for production)
DATABASE_URL="file:./dev.db"

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# Google OAuth (optional, for "Continue with Google")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Midtrans (https://dashboard.midtrans.com -> Settings -> Access Keys)
# Start with Sandbox keys (prefix SB-). Set MIDTRANS_IS_PRODUCTION=true only in production.
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# Public base URL of this app (used for payment finish URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
